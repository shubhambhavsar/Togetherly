{
  "manifest_version": 3,
  "name": "Togetherly Movie Sync Companion",
  "version": "0.1.0",
  "description": "Opt-in watch-party timing for accessible HTML5 video players on FlexFlix inside Togetherly. No stream downloads or ad filtering.",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://everydaygrove.ca/*"
      ],
      "js": [
        "togetherly-bridge.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flexflix.site/*",
        "https://www.flexflix.site/*"
      ],
      "js": [
        "drift.js",
        "player.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
